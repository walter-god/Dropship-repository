# Copy to .env and fill in. docker-compose reads this file automatically.
# Never commit the real .env — it is in .gitignore.
#
# Generate the two key values with:
#   SECRET_KEY:                   python -c "import secrets; print(secrets.token_urlsafe(50))"
#   DEPLOYER_ENV_ENCRYPTION_KEY:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Required -------------------------------------------------------------
SECRET_KEY=
POSTGRES_PASSWORD=

# Fernet key encrypting HostedApp.env_vars and db_password at rest.
# If left empty it is derived from SECRET_KEY, which means rotating SECRET_KEY
# silently orphans every stored credential. Set it explicitly.
DEPLOYER_ENV_ENCRYPTION_KEY=

# --- Payments -------------------------------------------------------------
# Shared secret from the payment provider. The webhook verifies an
# HMAC-SHA256 signature over the raw request body against this value.
# Leave empty and the webhook rejects everything — which is the right default
# until a provider is actually wired up.
PAYMENTS_WEBHOOK_SECRET=

# --- Optional overrides ---------------------------------------------------
# DEBUG must remain False outside local development: the debug page dumps the
# whole settings object, including SECRET_KEY.
# DEBUG=False
# SECURE_SSL_REDIRECT=True
# ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Student containers get no outbound internet by default. Egress is granted
# per-app by an admin (HostedApp.allow_egress), not globally.
# DEPLOYER_APP_DB_CONNECTION_LIMIT=20
# DEPLOYER_MAX_COMPRESSION_RATIO=100

# --- Frontend -------------------------------------------------------------
REACT_APP_API_URL=http://localhost:8000/api
